VERSION ""

NS_ :

BS_:

BU_: ECU1 ECU2

BA_DEF_ BO_ "VFrameFormat" ENUM "Standard","Extended";

VAL_TABLE_ LightStateVT 0 "Off" 1 "Parking" 2 "LowBeam" 3 "Auto";
