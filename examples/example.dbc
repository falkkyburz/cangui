VAL_ 1024 Headlights 0 "Off" 1 "Parking" 2 "LowBeam" 3 "Auto";
VAL_ 1024 TurnSignal 0 "Off" 1 "Left" 2 "Right" 3 "Reserved";
VAL_ 1024 HazardLights 0 "Inactive" 1 "Active";
VAL_ 1024 HighBeam 0 "Off" 1 "On";

CM_ BO_ 256 "Engine sensor data at 100ms cycle";
CM_ BO_ 512 "Vehicle speed and odometer";
CM_ BO_ 768 "Brake system status";
CM_ BO_ 1024 "Lighting control";
CM_ BO_ 1280 "64 x 1-bit signals for decode performance testing";
CM_ BO_ 1792 "E2E-protected sensor data (4-byte payload + counter nibble + CRC-8)";
CM_ BO_ 2566869221 "Extended ID example (29-bit).";
CM_ BO_ 1600 "CAN FD example with 64-byte payload.";
CM_ BO_ 1601 "CAN FD example (DLC 9 -> 12 bytes).";
CM_ BO_ 1602 "CAN FD example (DLC 10 -> 16 bytes).";
CM_ BO_ 1603 "CAN FD example (DLC 11 -> 20 bytes).";
CM_ BO_ 1604 "CAN FD example (DLC 12 -> 24 bytes).";
CM_ BO_ 1605 "CAN FD example (DLC 13 -> 32 bytes).";
CM_ BO_ 1606 "CAN FD example (DLC 14 -> 48 bytes).";
CM_ BO_ 1607 "CAN FD example (DLC 15 -> 64 bytes).";
CM_ SG_ 1792 E2E_Counter "Rolling 4-bit counter appended by E2E plugin (process_tx)";
CM_ SG_ 1792 E2E_CRC "CRC-8/MAXIM over payload + counter, appended by E2E plugin";
CM_ SG_ 256 EngineSpeed "Engine crankshaft speed";
CM_ SG_ 256 EngineTemp "Engine coolant temperature";
CM_ SG_ 512 Speed "Vehicle ground speed";
CM_ SG_ 768 BrakePedal "Brake pedal position percentage";

